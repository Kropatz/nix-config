+++ w/quickshell-lockscreen/shim/SddmShim.qml
@@ -163,10 +163,23 @@ Item {
         signal loginFailed()
         signal loginSucceeded()
 
+        // Fingerprint state surfaced to themes (opt-in: themes that don't read these are unaffected).
+        property string fingerprintMessage: ""
+        property bool fingerprintError: false
+        property bool fingerprintActive: false
+
         function login(user, password, sessionIndex) {
-            pam.user = user;
-            pam.pendingPassword = password;
-            pam.start();
+            if (pam.user !== user) {
+                pam.user = user;
+                pam.abort();
+                pam.start();
+            }
+            if (pam.needsPassword) {
+                pam.needsPassword = false;
+                pam.respond(password);
+            } else {
+                pam.pendingPassword = password;
+            }
         }
 
         function reboot() { Quickshell.execDetached(["bash", "-c", "if [ -d /run/systemd/system ]; then systemctl reboot; else loginctl reboot; fi"]); }
@@ -175,26 +188,69 @@ Item {
 
     PamContext {
         id: pam
+        config: "qylock"
+        user: Quickshell.env("USER") || ""
+
         property string pendingPassword: ""
+        property bool needsPassword: false
 
         onResponseRequiredChanged: {
-            if (responseRequired && pendingPassword !== "") {
+            if (!responseRequired) return;
+            // responseVisible=false → password-style prompt (pam_unix). Otherwise it's
+            // an interactive text prompt we don't handle; leave it for the user / fprintd retry.
+            if (responseVisible) return;
+            if (pendingPassword !== "") {
                 respond(pendingPassword);
                 pendingPassword = "";
+                needsPassword = false;
+            } else {
+                needsPassword = true;
             }
         }
 
+        onPamMessage: {
+            if (message === "") return;
+            shim.sddm.fingerprintMessage = message;
+            shim.sddm.fingerprintError = messageIsError;
+        }
+
         onCompleted: (result) => {
+            shim.sddm.fingerprintActive = false;
             if (result === PamResult.Success) {
+                shim.sddm.fingerprintMessage = "";
+                shim.sddm.fingerprintError = false;
                 shim.sddm.loginSucceeded();
                 Quickshell.execDetached(["loginctl", "unlock-session"]);
-                // Notify success handlers
             } else {
                 shim.sddm.loginFailed();
+                if (result !== PamResult.MaxTries) restartTimer.start();
             }
         }
+
+        onError: (err) => {
+            // Most common cause: /etc/pam.d/qylock missing. Surface it so themes can show something.
+            shim.sddm.fingerprintActive = false;
+            shim.sddm.fingerprintMessage = "PAM error (is /etc/pam.d/qylock configured?)";
+            shim.sddm.fingerprintError = true;
+        }
+    }
+
+    // Restart PAM after a failed attempt so fprintd / password can be retried.
+    Timer {
+        id: restartTimer
+        interval: 400
+        onTriggered: {
+            pam.pendingPassword = "";
+            pam.needsPassword = false;
+            shim.sddm.fingerprintMessage = "";
+            shim.sddm.fingerprintError = false;
+            if (pam.start()) shim.sddm.fingerprintActive = true;
+        }
     }
 
     onThemePathChanged: loadConfig(themePath)
-    Component.onCompleted: sessionEnumerator.running = true
+    Component.onCompleted: {
+        sessionEnumerator.running = true;
+        if (pam.start()) shim.sddm.fingerprintActive = true;
+    }
 }
